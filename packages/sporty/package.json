{
  "name": "@sportsdataverse/sporty",
  "version": "0.0.0",
  "description": "Sport surfaces (geometry and dimensions) for SportsDataverse plots — TypeScript port of sportyR/sportypy",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20.18.1" },
  "files": ["dist", "NOTICE.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./svg": { "types": "./dist/svg.d.ts", "import": "./dist/svg.js" },
    "./specs": { "types": "./dist/specs/index.d.ts", "import": "./dist/specs/index.js" },
    "./plot": { "types": "./dist/plot.d.ts", "import": "./dist/plot.js" },
    "./canvas": { "types": "./dist/canvas.d.ts", "import": "./dist/canvas.js" },
    "./d3": { "types": "./dist/d3.d.ts", "import": "./dist/d3.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "api:report": "node ../../tools/api-extractor-all.mjs --local",
    "api:check": "node ../../tools/api-extractor-all.mjs",
    "pack:check": "pnpm pack --pack-destination temp >/dev/null && attw temp/*.tgz --profile esm-only && publint --strict"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sportsdataverse/sdvplot-js",
    "directory": "packages/sporty"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": { "@observablehq/plot": ">=0.6.16", "d3": ">=7" },
  "peerDependenciesMeta": { "@observablehq/plot": { "optional": true }, "d3": { "optional": true } },
  "devDependencies": {
    "@observablehq/plot": "^0.6.17",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "jsdom": "^26.1.0"
  }
}
