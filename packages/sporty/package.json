{
  "name": "@sportsdataverse/sporty",
  "version": "0.0.0",
  "description": "Sport surfaces (geometry and dimensions) for SportsDataverse plots — TypeScript port of sportyR/sportypy",
  "license": "MIT",
  "keywords": [
    "sportsdataverse",
    "sports",
    "sports-analytics",
    "data-visualization",
    "court",
    "field",
    "rink",
    "pitch",
    "svg",
    "sportyR"
  ],
  "homepage": "https://plot.sportsdataverse.org",
  "bugs": "https://github.com/sportsdataverse/sdvplot-js/issues",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20.18.1" },
  "files": ["dist", "NOTICE.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./svg": { "types": "./dist/svg.d.ts", "import": "./dist/svg.js" },
    "./specs": { "types": "./dist/specs/index.d.ts", "import": "./dist/specs/index.js" },
    "./plot": { "types": "./dist/plot.d.ts", "import": "./dist/plot.js" },
    "./canvas": { "types": "./dist/canvas.d.ts", "import": "./dist/canvas.js" },
    "./d3": { "types": "./dist/d3.d.ts", "import": "./dist/d3.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "api:report": "node ../../tools/api-extractor-all.mjs --local",
    "api:check": "node ../../tools/api-extractor-all.mjs",
    "pack:check": "node ../../tools/pack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sportsdataverse/sdvplot-js.git",
    "directory": "packages/sporty"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": { "@observablehq/plot": ">=0.6.16", "d3": ">=7", "@napi-rs/canvas": ">=0.1.50" },
  "peerDependenciesMeta": {
    "@observablehq/plot": { "optional": true },
    "d3": { "optional": true },
    "@napi-rs/canvas": { "optional": true }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@observablehq/plot": "^0.6.17",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3": "^7.4.3",
    "@types/pngjs": "^6.0.5",
    "d3": "^7.9.0",
    "jsdom": "^26.1.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
