{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@sportsdataverse/sporty": ["../sporty/src/index.ts"],
      "@sportsdataverse/sporty/plot": ["../sporty/src/plot.ts"],
      "@sportsdataverse/sporty/d3": ["../sporty/src/d3.ts"],
      "@sportsdataverse/sporty/canvas": ["../sporty/src/canvas.ts"],
      "@sportsdataverse/sporty/svg": ["../sporty/src/svg.ts"]
    }
  },
  "include": ["src", "test"],
  // the ./svelte layer imports .svelte files, which tsc cannot read: svelte-check types it (tsconfig.svelte.json)
  // Unovis 1.7's declarations re-export folders without file extensions, which only bundler resolution follows (under
  // NodeNext "@unovis/ts" exports no types), and are not written for exactOptionalPropertyTypes: tsconfig.unovis.json
  // checks the two tests that import them. ./unovis itself never imports Unovis, so its published types need neither.
  "exclude": ["src/svelte", "test/svelte", "test/unovis-render.test.ts", "test/unovis.types.ts"]
}
