{
  "name": "@sportsdataverse/sdvplot",
  "version": "0.0.0",
  "description": "Team identity, colors, logos and headshots for SportsDataverse plots — TypeScript port of sdvplot/sdvplotR",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.18.1"
  },
  "files": ["dist", "NOTICE.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./plot": {
      "types": "./dist/plot.d.ts",
      "import": "./dist/plot.js"
    },
    "./d3": {
      "types": "./dist/d3.d.ts",
      "import": "./dist/d3.js"
    },
    "./chartjs": {
      "types": "./dist/chartjs.d.ts",
      "import": "./dist/chartjs.js"
    },
    "./chartjs/surface": {
      "types": "./dist/chartjs-surface.d.ts",
      "import": "./dist/chartjs-surface.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@observablehq/plot": ">=0.6.16",
    "@sportsdataverse/sporty": "workspace:^",
    "chart.js": ">=4.4",
    "d3": ">=7",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "@observablehq/plot": {
      "optional": true
    },
    "d3": {
      "optional": true
    },
    "@sportsdataverse/sporty": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "api:report": "node ../../tools/api-extractor-all.mjs --local",
    "api:check": "node ../../tools/api-extractor-all.mjs",
    "pack:check": "pnpm pack --pack-destination temp >/dev/null && attw temp/*.tgz --profile esm-only && publint --strict"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sportsdataverse/sdvplot-js",
    "directory": "packages/sdvplot"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@observablehq/plot": "^0.6.17",
    "@sportsdataverse/sporty": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chart.js": "4.5.1",
    "d3": "^7.9.0",
    "jsdom": "^26.1.0",
    "linkedom": "^0.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
