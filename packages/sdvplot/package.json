{
  "name": "@sportsdataverse/sdvplot",
  "version": "0.1.0",
  "description": "Team identity, colors, logos and headshots for SportsDataverse plots — TypeScript port of sdvplot/sdvplotR",
  "license": "MIT",
  "keywords": [
    "sportsdataverse",
    "sports",
    "sports-analytics",
    "data-visualization",
    "team-colors",
    "team-logos",
    "headshots",
    "observable-plot",
    "d3",
    "chartjs",
    "react",
    "recharts",
    "uplot",
    "nivo",
    "victory"
  ],
  "homepage": "https://plot.sportsdataverse.org",
  "bugs": "https://github.com/sportsdataverse/sdvplot-js/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.18.1"
  },
  "files": ["dist", "NOTICE.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./plot": {
      "types": "./dist/plot.d.ts",
      "import": "./dist/plot.js"
    },
    "./d3": {
      "types": "./dist/d3.d.ts",
      "import": "./dist/d3.js"
    },
    "./bins": {
      "types": "./dist/bins.d.ts",
      "import": "./dist/bins.js"
    },
    "./shots": {
      "types": "./dist/shots.d.ts",
      "import": "./dist/shots.js"
    },
    "./chartjs": {
      "types": "./dist/chartjs.d.ts",
      "import": "./dist/chartjs.js"
    },
    "./chartjs/surface": {
      "types": "./dist/chartjs-surface.d.ts",
      "import": "./dist/chartjs-surface.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./interact": {
      "types": "./dist/interact.d.ts",
      "import": "./dist/interact.js"
    },
    "./plotly": {
      "types": "./dist/plotly.d.ts",
      "import": "./dist/plotly.js"
    },
    "./vega": {
      "types": "./dist/vega.d.ts",
      "import": "./dist/vega.js"
    },
    "./echarts": {
      "types": "./dist/echarts.d.ts",
      "import": "./dist/echarts.js"
    },
    "./recharts": {
      "types": "./dist/recharts.d.ts",
      "import": "./dist/recharts.js"
    },
    "./uplot": {
      "types": "./dist/uplot.d.ts",
      "import": "./dist/uplot.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js"
    },
    "./nivo": {
      "types": "./dist/nivo.d.ts",
      "import": "./dist/nivo.js"
    },
    "./victory": {
      "types": "./dist/victory.d.ts",
      "import": "./dist/victory.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@nivo/bump": ">=0.99",
    "@nivo/chord": ">=0.99",
    "@nivo/core": ">=0.99",
    "@nivo/swarmplot": ">=0.99",
    "@observablehq/plot": ">=0.6.16",
    "@resvg/resvg-js": ">=2.6",
    "@sportsdataverse/sporty": "workspace:^0",
    "chart.js": ">=4.4",
    "d3": ">=7",
    "layerchart": ">=2.5.1",
    "react": ">=18",
    "recharts": ">=3.8",
    "svelte": ">=5.57",
    "uplot": ">=1.6.31",
    "victory": ">=37.3.6"
  },
  "peerDependenciesMeta": {
    "@nivo/bump": {
      "optional": true
    },
    "@nivo/chord": {
      "optional": true
    },
    "@nivo/core": {
      "optional": true
    },
    "@nivo/swarmplot": {
      "optional": true
    },
    "@observablehq/plot": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    },
    "@sportsdataverse/sporty": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "d3": {
      "optional": true
    },
    "layerchart": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "uplot": {
      "optional": true
    },
    "victory": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && svelte-package -i src/svelte -o dist/svelte --tsconfig ./tsconfig.svelte.json && node ../../tools/svelte-dts.mjs dist/svelte",
    "typecheck": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "test": "vitest run",
    "api:report": "node ../../tools/api-extractor-all.mjs --local",
    "api:check": "node ../../tools/api-extractor-all.mjs",
    "pack:check": "node ../../tools/pack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sportsdataverse/sdvplot-js.git",
    "directory": "packages/sdvplot"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@nivo/bump": "0.99.0",
    "@nivo/chord": "0.99.0",
    "@nivo/core": "0.99.0",
    "@nivo/swarmplot": "0.99.0",
    "@observablehq/plot": "^0.6.17",
    "@resvg/resvg-js": "^2.6.2",
    "@sportsdataverse/sporty": "workspace:^",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.7",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chart.js": "4.5.1",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "jsdom": "^26.1.0",
    "layerchart": "2.5.1",
    "linkedom": "^0.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "3.10.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "uplot": "1.6.32",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "victory": "37.3.6"
  }
