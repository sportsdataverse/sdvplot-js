{
  "name": "@sportsdataverse/sdvtables",
  "version": "0.0.0",
  "description": "Publication tables for SportsDataverse data — TableSpec, 18+3 themes, team logos/headshots/colors, static HTML renderer. TypeScript port of sdvplotR gt_* / gtUtils",
  "license": "MIT",
  "keywords": [
    "sportsdataverse",
    "sports",
    "sports-analytics",
    "tables",
    "html-tables",
    "gt",
    "great-tables",
    "team-logos"
  ],
  "homepage": "https://plot.sportsdataverse.org",
  "bugs": "https://github.com/sportsdataverse/sdvplot-js/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.18.1"
  },
  "files": ["dist", "NOTICE.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "api:report": "node ../../tools/api-extractor-all.mjs --local",
    "api:check": "node ../../tools/api-extractor-all.mjs",
    "pack:check": "node ../../tools/pack-check.mjs"
  },
  "peerDependencies": {
    "@sportsdataverse/sdvplot": "workspace:^0"
  },
  "devDependencies": {
    "@sportsdataverse/sdvplot": "workspace:^",
    "happy-dom": "^15.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sportsdataverse/sdvplot-js.git",
    "directory": "packages/sdvtables"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
